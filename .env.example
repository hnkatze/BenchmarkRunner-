# Copy to .env and fill in. NEVER commit .env — .gitignore already blocks it.
# Every value here is read on the server only. None of it reaches the browser.

# ---------------------------------------------------------------------------
# Firestore — Google Cloud service account
# ---------------------------------------------------------------------------
# console.cloud.google.com > IAM & Admin > Service Accounts > Create
#   role: "Cloud Datastore User"
#   then Keys > Add key > Create new key > JSON
# The downloaded JSON contains all three values below.
FIRESTORE_PROJECT_ID=
FIRESTORE_CLIENT_EMAIL=
# Paste the full key INCLUDING the BEGIN/END lines, wrapped in double quotes.
# Keep the literal \n sequences exactly as they appear in the JSON.
FIRESTORE_PRIVATE_KEY=""
# Firestore region, e.g. us-central1. Must match the Atlas region below.
FIRESTORE_REGION=

# ---------------------------------------------------------------------------
# MongoDB — Atlas M0 (free tier)
# ---------------------------------------------------------------------------
# cloud.mongodb.com > Create a free M0 cluster
#   Pick the SAME region as Firestore, or the comparison is meaningless.
#   Network Access > add your IP. Database Access > create a user.
#   Connect > Drivers > copy the connection string.
MONGODB_URI=
MONGODB_DB=db_bench

# ---------------------------------------------------------------------------
# Benchmark safety limits (server-side, not user-controllable)
# ---------------------------------------------------------------------------
# Hard ceiling on iterations per phase, whatever the UI asks for.
# Guards against a stray request burning through your free tier quota.
BENCH_MAX_ITERATIONS=500
