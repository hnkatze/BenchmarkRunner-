---
import BenchmarkConsole from '../benchmark/ui/BenchmarkConsole.astro'
import Layout from '../layouts/Layout.astro'
import { ghostButton } from '../ui/button-recipes'
import { icon } from '../ui/icons'

/* A pixel bar chart in the two engine colours — the same pair the real chart
   uses, so the mark states what the page does instead of filling space. It
   survives the move to Cursor because it reads as a data figure, which is the
   one place the engine colours are allowed to appear. The third tone dropped
   with Caldera's yellow and is now a hairline grey. Columns are 20px squares
   on a 24px step, cornered at 2px to match Cursor's tight geometry. */
const PIXELS = [
  { x: 0, y: 72, tone: 'firestore' },
  { x: 24, y: 72, tone: 'firestore' },
  { x: 24, y: 48, tone: 'firestore' },
  { x: 24, y: 24, tone: 'firestore' },
  { x: 24, y: 0, tone: 'glare' },
  { x: 48, y: 72, tone: 'firestore' },
  { x: 48, y: 48, tone: 'firestore' },
  { x: 72, y: 72, tone: 'firestore' },
  { x: 72, y: 48, tone: 'firestore' },
  { x: 72, y: 24, tone: 'firestore' },
  { x: 72, y: 0, tone: 'firestore' },
  { x: 96, y: 72, tone: 'mongodb' },
  { x: 96, y: 48, tone: 'mongodb' },
  { x: 96, y: 24, tone: 'glare' },
  { x: 120, y: 72, tone: 'mongodb' },
  { x: 144, y: 72, tone: 'mongodb' },
  { x: 144, y: 48, tone: 'mongodb' },
  { x: 144, y: 24, tone: 'mongodb' },
  { x: 168, y: 72, tone: 'mongodb' },
] as const

const TONE_FILL = {
  firestore: 'var(--color-firestore)',
  mongodb: 'var(--color-mongodb)',
  glare: 'var(--color-hairline-strong)',
} as const
---

<Layout>
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded-button focus:bg-primary focus:px-6 focus:py-3 focus:text-body-sm focus:font-medium focus:text-canvas"
  >
    Saltar al contenido
  </a>

  <div class="min-h-dvh bg-canvas">
    <header class="animate-rise mx-auto w-full max-w-dashboard px-5 pt-10 pb-8 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-end justify-between gap-8">
        <div>
          <h1 class="text-display-lg text-primary">
            Firestore <span class="text-firestore">vs</span> MongoDB
          </h1>
          <p class="mt-4 max-w-prose text-body-md text-secondary">
            Latencia y rendimiento en operaciones habituales sobre documentos.
          </p>
          <a href="/proyecto" class={`mt-6 inline-flex items-center gap-2 ${ghostButton('sm')}`}>
            <Fragment set:html={icon('circle-help', 'size-4')} />
            Cómo está hecho y qué mide
          </a>
        </div>

        <svg
          class="hidden h-24 w-auto shrink-0 lg:block"
          viewBox="0 0 188 92"
          aria-hidden="true"
          focusable="false"
        >
          {
            PIXELS.map((pixel) => (
              <rect
                x={pixel.x}
                y={pixel.y}
                width="20"
                height="20"
                rx="2"
                fill={TONE_FILL[pixel.tone]}
              />
            ))
          }
        </svg>
      </div>
    </header>

    <main id="main" class="mx-auto w-full max-w-dashboard px-5 pb-16 sm:px-6 lg:px-8">
      {/* Full-bleed block, but the prose keeps a readable measure: at the dashboard's
          width a single column would run past 200 characters per line. */}
      <div class="animate-rise delay-75 mb-8 grid gap-4 rounded-card border border-hairline bg-inset p-6 lg:grid-cols-[minmax(0,16rem)_minmax(0,1fr)] lg:items-baseline lg:gap-10">
        <p class="flex items-start gap-3 text-primary">
          <span class="mt-1 inline-flex shrink-0 text-firestore" set:html={icon('circle-alert', 'size-6')} />
          <span class="text-display-md">
            Firestore en nam5 · multirregión
          </span>
        </p>
        <p class="max-w-prose text-body-md text-primary">
          Las escrituras replican entre regiones de EE. UU. antes de confirmarse, así que su latencia
          de escritura incluye ese consenso. Las mediciones son reales y salen del
          puerto <code class="font-mono text-body-sm">BenchmarkRunner</code> ejecutándose en el servidor.
        </p>
      </div>

      <BenchmarkConsole />
    </main>
  </div>
</Layout>

<script>
  import { createHttpBenchmarkRunner } from '../benchmark/adapters/http-benchmark-runner'
  import { BenchmarkConsole } from '../benchmark/ui/benchmark-console'
  import { initIndexPanel } from '../benchmark/ui/index-panel'

  // Independent of the island: the indexes have to be checkable before a run,
  // which is precisely when the console has nothing to say yet.
  initIndexPanel()

  // Composition root: the only place allowed to know which adapter drives the island.
  // `instanceof` rather than querySelector<T>, which only asserts the type.
  customElements.whenDefined('benchmark-console').then(() => {
    const island = document.querySelector('benchmark-console')
    if (island instanceof BenchmarkConsole) {
      island.setRunner(createHttpBenchmarkRunner())
    }
  })
</script>
