---
import BenchmarkConsole from '../benchmark/ui/BenchmarkConsole.astro'
import Layout from '../layouts/Layout.astro'
import { icon } from '../ui/icons'

/* Caldera's decorative language is large two-tone pixel graphics. This one is
   a pixelated bar chart — orange against violet, the same pair the real chart
   uses — so the decoration says what the page is about instead of just filling
   space. Columns are 20px squares on a 24px step. */
const PIXELS = [
  { x: 0, y: 72, tone: 'firestore' },
  { x: 24, y: 72, tone: 'firestore' },
  { x: 24, y: 48, tone: 'firestore' },
  { x: 24, y: 24, tone: 'firestore' },
  { x: 24, y: 0, tone: 'glare' },
  { x: 48, y: 72, tone: 'firestore' },
  { x: 48, y: 48, tone: 'firestore' },
  { x: 72, y: 72, tone: 'firestore' },
  { x: 72, y: 48, tone: 'firestore' },
  { x: 72, y: 24, tone: 'firestore' },
  { x: 72, y: 0, tone: 'firestore' },
  { x: 96, y: 72, tone: 'mongodb' },
  { x: 96, y: 48, tone: 'mongodb' },
  { x: 96, y: 24, tone: 'glare' },
  { x: 120, y: 72, tone: 'mongodb' },
  { x: 144, y: 72, tone: 'mongodb' },
  { x: 144, y: 48, tone: 'mongodb' },
  { x: 144, y: 24, tone: 'mongodb' },
  { x: 168, y: 72, tone: 'mongodb' },
] as const

const TONE_FILL = {
  firestore: 'var(--color-firestore)',
  mongodb: 'var(--color-mongodb)',
  glare: 'var(--color-pixel-glare)',
} as const
---

<Layout>
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded-button focus:bg-abyssal-ink focus:px-6 focus:py-3 focus:text-body-sm focus:font-medium focus:text-pure-white"
  >
    Saltar al contenido
  </a>

  <div class="min-h-dvh bg-canvas">
    <header class="mx-auto w-full max-w-dashboard px-5 pt-10 pb-8 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-end justify-between gap-8">
        <div>
          <h1 class="font-title text-heading-sm uppercase text-primary sm:text-heading">
            Firestore <span class="text-digital-orange">vs</span> MongoDB
          </h1>
          <p class="mt-4 max-w-prose text-body text-secondary">
            Latencia y rendimiento en operaciones habituales sobre documentos.
          </p>
        </div>

        <svg
          class="hidden h-24 w-auto shrink-0 lg:block"
          viewBox="0 0 188 92"
          aria-hidden="true"
          focusable="false"
        >
          {
            PIXELS.map((pixel) => (
              <rect
                x={pixel.x}
                y={pixel.y}
                width="20"
                height="20"
                rx="5"
                fill={TONE_FILL[pixel.tone]}
              />
            ))
          }
        </svg>
      </div>
    </header>

    <main id="main" class="mx-auto w-full max-w-dashboard px-5 pb-16 sm:px-6 lg:px-8">
      {/* Full-bleed block, but the prose keeps a readable measure: at the dashboard's
          width a single column would run past 200 characters per line. */}
      <div class="mb-10 grid gap-6 rounded-card bg-pixel-glare p-10 lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)] lg:items-start lg:gap-16">
        <p class="flex items-start gap-3 text-abyssal-ink">
          <span class="mt-1 inline-flex shrink-0" set:html={icon('circle-alert', 'size-6')} />
          <span class="font-title text-subheading uppercase leading-none">
            Firestore en nam5 · multirregión
          </span>
        </p>
        <p class="max-w-prose text-body text-abyssal-ink">
          Las escrituras replican entre regiones de EE. UU. antes de confirmarse, así que su latencia
          de escritura incluye ese consenso. Las mediciones son reales y salen del
          puerto <code class="font-mono text-body-sm">BenchmarkRunner</code> ejecutándose en el servidor.
        </p>
      </div>

      <BenchmarkConsole />
    </main>
  </div>
</Layout>

<script>
  import { createHttpBenchmarkRunner } from '../benchmark/adapters/http-benchmark-runner'
  import { BenchmarkConsole } from '../benchmark/ui/benchmark-console'

  // Composition root: the only place allowed to know which adapter drives the island.
  // `instanceof` rather than querySelector<T>, which only asserts the type.
  customElements.whenDefined('benchmark-console').then(() => {
    const island = document.querySelector('benchmark-console')
    if (island instanceof BenchmarkConsole) {
      island.setRunner(createHttpBenchmarkRunner())
    }
  })
</script>
