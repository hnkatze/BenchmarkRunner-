---
import { CONFIG_LIMITS, DEFAULT_CONFIG, ENGINE_IDS, OPERATION_IDS } from '../domain'
import { ghostButton, solidButton } from '../../ui/button-recipes'
import Checkbox from '../../ui/Checkbox.astro'
import { icon } from '../../ui/icons'
import { ENGINE_DISPLAY, OPERATION_DISPLAY } from './labels'

/* Caldera cards: Ash White, 40px radius, 40px padding. The padding applies to
   the container — never to a table row, which would make the data unreadable. */
const panel = 'rounded-card bg-surface p-10'
const legendText = 'text-xs font-semibold uppercase tracking-widest text-muted'

/* Pill inputs, 100px radius. Focus inverts the border to full ink rather than
   adding a glow: the system is flat and has no shadows. */
const numberField =
  'w-full rounded-input border border-subtle bg-canvas px-6 py-3 font-mono text-body-sm text-primary tnum outline-none focus-visible:border-strong focus-visible:ring-2 focus-visible:ring-abyssal-ink/20'

const numericFields = [
  {
    name: 'iterations',
    label: 'Iteraciones',
    hint: 'Muestras por motor y operación',
    value: DEFAULT_CONFIG.iterations,
    limits: CONFIG_LIMITS.iterations,
  },
  {
    name: 'warmupIterations',
    label: 'Calentamiento',
    hint: 'Descartadas antes de medir',
    value: DEFAULT_CONFIG.warmupIterations,
    limits: CONFIG_LIMITS.warmupIterations,
  },
  {
    name: 'documentSizeBytes',
    label: 'Tamaño del documento',
    hint: 'Payload en bytes',
    value: DEFAULT_CONFIG.documentSizeBytes,
    limits: CONFIG_LIMITS.documentSizeBytes,
  },
  {
    name: 'concurrency',
    label: 'Concurrencia',
    hint: 'Workers en paralelo',
    value: DEFAULT_CONFIG.concurrency,
    limits: CONFIG_LIMITS.concurrency,
  },
] as const
---

<benchmark-console class="grid gap-10 lg:grid-cols-[24rem_minmax(0,1fr)] lg:items-start">
  {/* Two rows: the fields scroll, the action does not. A sticky footer INSIDE the
      scroll area would float over the fields it is meant to sit below. */}
  <form
    data-ref="form"
    class="grid overflow-hidden rounded-card bg-surface lg:sticky lg:top-6 lg:max-h-[calc(100dvh-3rem)] lg:grid-rows-[minmax(0,1fr)_auto]"
    novalidate
  >
   <div class="grid gap-8 overflow-y-auto p-10">
    <fieldset class="grid gap-2.5">
      <legend class={`${legendText} mb-2.5`}>Motores</legend>
      {
        ENGINE_IDS.map((engine) => (
          <label class="flex cursor-pointer items-center gap-4 rounded-input border border-subtle bg-canvas px-5 py-4 transition-colors has-checked:border-strong">
            <Checkbox name="engine" value={engine} checked />
            <span class="grid gap-0.5">
              <span class="flex items-center gap-2 text-body-sm font-medium text-primary">
                {/* The mark carries the engine's colour, so no separate dot is needed. */}
                <span
                  class="inline-flex"
                  style={`color: var(${ENGINE_DISPLAY[engine].colorVar})`}
                  set:html={icon(ENGINE_DISPLAY[engine].icon, 'size-5')}
                />
                {ENGINE_DISPLAY[engine].label}
              </span>
              <span class="text-xs text-muted">{ENGINE_DISPLAY[engine].tagline}</span>
            </span>
          </label>
        ))
      }
    </fieldset>

    <fieldset class="grid gap-1">
      <legend class={`${legendText} mb-2.5`}>Operaciones</legend>
      {
        OPERATION_IDS.map((operation) => (
          <label class="flex cursor-pointer items-center gap-4 rounded-input px-4 py-2.5 transition-colors hover:bg-raised">
            <Checkbox
              name="operation"
              value={operation}
              checked={DEFAULT_CONFIG.operations.includes(operation)}
            />
            <span
              class="inline-flex shrink-0 text-secondary"
              set:html={icon(OPERATION_DISPLAY[operation].icon, 'size-5')}
            />
            <span class="grid gap-0.5">
              <span class="text-body-sm text-primary">{OPERATION_DISPLAY[operation].label}</span>
              <span class="text-xs text-muted">{OPERATION_DISPLAY[operation].description}</span>
            </span>
          </label>
        ))
      }
    </fieldset>

    <fieldset class="grid gap-5">
      <legend class={`${legendText} mb-2.5`}>Carga de trabajo</legend>
      {
        numericFields.map((field) => (
          <div class="grid gap-2">
            <label for={`field-${field.name}`} class="px-2 text-body-sm font-medium text-secondary">
              {field.label}
            </label>
            <input
              id={`field-${field.name}`}
              name={field.name}
              type="number"
              inputmode="numeric"
              value={field.value}
              min={field.limits.min}
              max={field.limits.max}
              step="1"
              aria-describedby={`hint-${field.name}`}
              class={numberField}
            />
            <span id={`hint-${field.name}`} class="px-2 text-xs text-muted">
              {field.hint}
            </span>
          </div>
        ))
      }
    </fieldset>

    <ul
      data-ref="errors"
      hidden
      class="grid gap-1 rounded-card bg-abyssal-ink p-6 text-body-sm text-pure-white"
    >
    </ul>
   </div>

    <div class="flex flex-wrap gap-2.5 border-t border-subtle bg-surface px-10 py-6">
      <button type="submit" data-ref="run" class={`flex-1 ${solidButton()}`}>
        <span class="flex items-center justify-center gap-2">
          <span data-ref="run-icon" class="inline-flex" set:html={icon('play', 'size-4')} />
          <span data-ref="run-label">Ejecutar benchmark</span>
        </span>
      </button>
      <button type="button" data-ref="cancel" hidden class={ghostButton()}>
        Cancelar
      </button>
    </div>
  </form>

  <div class="grid gap-10">
    <section class={panel} aria-labelledby="progress-heading">
      <div class="flex items-baseline justify-between gap-4">
        <h2 id="progress-heading" class={legendText}>Progreso de la ejecución</h2>
        <span data-ref="progress-label" class="font-mono text-body-sm tnum text-primary">0%</span>
      </div>

      <div
        data-ref="progress-track"
        role="progressbar"
        aria-labelledby="progress-heading"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
        class="mt-5 h-3 overflow-hidden rounded-full bg-canvas"
      >
        <div
          data-ref="progress-bar"
          style="width: 0%"
          class="h-full rounded-full bg-abyssal-ink transition-[width] duration-150 ease-out"
        >
        </div>
      </div>

      <p data-ref="status" role="status" aria-live="polite" class="mt-5 text-body text-secondary">
        En espera. Configura una ejecución e iníciala.
      </p>
    </section>

    <section class={panel} aria-labelledby="chart-heading">
      <h2 id="chart-heading" class={`${legendText} flex items-center gap-2`}>
        <Fragment set:html={icon('chart-bar', 'size-4')} />
        Comparación de latencia p95
      </h2>
      <div data-ref="chart" class="pt-6"></div>
    </section>

    <section class={`${panel} px-0`} aria-labelledby="results-heading">
      <h2 id="results-heading" class={`${legendText} flex items-center gap-2 px-10`}>
        <Fragment set:html={icon('table-2', 'size-4')} />
        Distribución de latencia
      </h2>
      <div data-ref="results" class="pt-4"></div>
    </section>
  </div>
</benchmark-console>

<script>
  import './benchmark-console'
</script>
