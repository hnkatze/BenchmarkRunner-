---
import { CONFIG_LIMITS, DEFAULT_CONFIG, ENGINE_IDS, OPERATION_IDS } from '../domain'
import { QUERY_SPECS, queriesOfKind } from '../../dataset/domain/queries.ts'
import { ghostButton, segmentButton, segmentTrack, solidButton } from '../../ui/button-recipes'
import Checkbox from '../../ui/Checkbox.astro'
import { icon } from '../../ui/icons'
import { COPY, GLOSSARY, INDEX_COPY, type GlossaryTermId } from './copy'
import { infoTip } from '../../ui/info-tip'
import { ENGINE_DISPLAY, PHASE_DISPLAY, firestoreStrategyLabel } from './labels'

/* Caldera cards: Ash White, 40px radius, 40px padding. The padding applies to
   the container — never to a table row, which would make the data unreadable. */
const panel = 'rounded-card bg-surface p-10'
const legendText = 'text-caption-uppercase font-semibold text-muted'

/* Pill inputs, 100px radius. Focus inverts the border to full ink rather than
   adding a glow: the system is flat and has no shadows. */
const numberField =
  'w-full rounded-input border border-hairline bg-canvas px-6 py-3 font-mono text-body-sm text-primary tnum outline-none focus-visible:border-hairline-strong focus-visible:ring-2 focus-visible:ring-primary/20'

/** Scoped ids: the same term also appears in the results table. */
const tip = (term: GlossaryTermId): string =>
  infoTip({ id: `tip-form-${term}`, term: GLOSSARY[term].term, definition: GLOSSARY[term].definition })

const numericFields = [
  {
    name: 'iterations',
    term: 'iterations' satisfies GlossaryTermId,
    label: 'Iteraciones',
    hint: 'Muestras por motor y operación',
    value: DEFAULT_CONFIG.iterations,
    limits: CONFIG_LIMITS.iterations,
  },
  {
    name: 'warmupIterations',
    term: 'warmup' satisfies GlossaryTermId,
    label: 'Calentamiento',
    hint: 'Descartadas antes de medir',
    value: DEFAULT_CONFIG.warmupIterations,
    limits: CONFIG_LIMITS.warmupIterations,
  },
  {
    name: 'documentSizeBytes',
    term: 'documentSize' satisfies GlossaryTermId,
    label: 'Tamaño del documento',
    hint: 'Payload en bytes',
    value: DEFAULT_CONFIG.documentSizeBytes,
    limits: CONFIG_LIMITS.documentSizeBytes,
  },
  {
    name: 'concurrency',
    term: 'concurrency' satisfies GlossaryTermId,
    label: 'Concurrencia',
    hint: 'Workers en paralelo',
    value: DEFAULT_CONFIG.concurrency,
    limits: CONFIG_LIMITS.concurrency,
  },
] as const
---

{/* Two steps, not two columns. The parameters used to hold 24rem for the whole
    session, which is exactly the width the table and the chart want back once
    there is data to read. The control bar stays outside both steps so a rerun
    never costs a trip back to the form. */}
<benchmark-console class="grid gap-8">
  <div
    class="flex flex-wrap items-center justify-between gap-x-6 gap-y-4 rounded-card bg-surface px-8 py-5"
  >
    <div class={segmentTrack} role="tablist" aria-label="Pasos">
      <button
        type="button"
        data-ref="step-tab"
        data-step="setup"
        role="tab"
        aria-selected="true"
        class={segmentButton(true)}
      >
        {COPY.steps.configure}
      </button>
      <button
        type="button"
        data-ref="step-tab"
        data-step="analysis"
        role="tab"
        aria-selected="false"
        class={segmentButton(false)}
      >
        {COPY.steps.analyze}
      </button>
    </div>

    {/* What is about to run, in one line, so the analysis step never has to
        guess which configuration produced the numbers on screen. */}
    <p data-ref="summary" class="font-mono text-caption tnum text-muted"></p>

    <div class="flex flex-wrap gap-2.5">
      {/* Associated by id, not by nesting: the button lives outside the form so
          it survives the step switch. */}
      <button type="submit" form="benchmark-form" data-ref="run" class={solidButton()}>
        <span class="flex items-center justify-center gap-2">
          <span data-ref="run-icon" class="inline-flex" set:html={icon('play', 'size-4')} />
          <span data-ref="run-label">Ejecutar benchmark</span>
        </span>
      </button>
      <button type="button" data-ref="cancel" hidden class={ghostButton()}>
        Cancelar
      </button>
    </div>
  </div>

  <form
    id="benchmark-form"
    data-ref="form"
    class="rounded-card bg-surface p-10"
    novalidate
  >
   <div class="grid gap-10 md:grid-cols-2 xl:grid-cols-3">
    <fieldset class="grid gap-2.5">
      <legend class={`${legendText} mb-2.5`}>Motores</legend>
      {
        ENGINE_IDS.map((engine) => (
          <label class="flex cursor-pointer items-center gap-4 rounded-input border border-hairline bg-canvas px-5 py-4 transition-colors has-checked:border-hairline-strong">
            <Checkbox name="engine" value={engine} checked />
            <span class="grid gap-0.5">
              <span class="flex items-center gap-2 text-body-sm font-medium text-primary">
                {/* The mark carries the engine's colour, so no separate dot is needed. */}
                <span
                  class="inline-flex"
                  style={`color: var(${ENGINE_DISPLAY[engine].colorVar})`}
                  set:html={icon(ENGINE_DISPLAY[engine].icon, 'size-5')}
                />
                {ENGINE_DISPLAY[engine].label}
              </span>
              <span class="text-xs text-muted">{ENGINE_DISPLAY[engine].tagline}</span>
            </span>
          </label>
        ))
      }
    </fieldset>

    <fieldset class="grid gap-1">
      <legend class={`${legendText} mb-2.5`}>Operaciones</legend>
      {
        OPERATION_IDS.map((operation) => (
          <label class="flex cursor-pointer items-center gap-4 rounded-input px-4 py-2.5 transition-colors hover:bg-raised">
            <Checkbox
              name="operation"
              value={operation}
              checked={DEFAULT_CONFIG.operations.includes(operation)}
            />
            <span
              class="inline-flex shrink-0 text-secondary"
              set:html={icon(PHASE_DISPLAY[operation].icon, 'size-5')}
            />
            <span class="grid gap-0.5">
              <span class="text-body-sm text-primary">{PHASE_DISPLAY[operation].label}</span>
              <span class="text-xs text-muted">{PHASE_DISPLAY[operation].description}</span>
            </span>
          </label>
        ))
      }
    </fieldset>

    <fieldset class="grid gap-1">
      <legend class={`${legendText} mb-2.5`}>Consultas simples</legend>
      {
        queriesOfKind('simple').map((query) => (
          <label class="flex cursor-pointer items-start gap-4 rounded-input px-4 py-2.5 transition-colors hover:bg-raised">
            <Checkbox name="query" value={query} />
            <span
              class="mt-0.5 inline-flex shrink-0 text-secondary"
              set:html={icon(PHASE_DISPLAY[query].icon, 'size-5')}
            />
            <span class="grid gap-0.5">
              <span class="text-body-sm text-primary">{PHASE_DISPLAY[query].label}</span>
              <span class="text-caption text-muted">{QUERY_SPECS[query].question}</span>
            </span>
          </label>
        ))
      }
    </fieldset>

    <fieldset class="grid gap-1">
      <legend class={`${legendText} mb-2.5`}>Consultas complejas</legend>
      {
        queriesOfKind('complex').map((query) => (
          <label class="flex cursor-pointer items-start gap-4 rounded-input px-4 py-2.5 transition-colors hover:bg-raised">
            <Checkbox name="query" value={query} />
            <span
              class="mt-0.5 inline-flex shrink-0 text-secondary"
              set:html={icon(PHASE_DISPLAY[query].icon, 'size-5')}
            />
            <span class="grid gap-0.5">
              <span class="text-body-sm text-primary">{PHASE_DISPLAY[query].label}</span>
              <span class="text-caption text-muted">{QUERY_SPECS[query].question}</span>
              {/* Stated next to every complex query on purpose: five of the ten
                  only run because the missing engine was written by hand, and a
                  latency number without that caveat is a lie of omission. */}
              <span class="mt-1 text-caption text-firestore">{firestoreStrategyLabel(query)}</span>
            </span>
          </label>
        ))
      }
    </fieldset>

    {/* Los índices viven en el proyecto, no en el repositorio: apuntar la app a
        otro proyecto los deja en cero y siete consultas fallan. Revisar es
        gratis y sin permisos especiales; crear necesita un rol de IAM. */}
    <div class="grid gap-2.5" data-ref="index-panel">
      <span class={`${legendText} mb-2.5`}>{INDEX_COPY.title}</span>
      <p class="px-2 text-caption text-muted">{INDEX_COPY.explainer}</p>
      <p
        data-ref="index-status"
        class="rounded-input border border-hairline bg-canvas px-5 py-4 text-body-sm text-secondary"
      >
        {INDEX_COPY.idle}
      </p>
      <div class="flex flex-wrap gap-2.5">
        <button type="button" data-ref="index-check" class={ghostButton('sm')}>
          {INDEX_COPY.check}
        </button>
        <button type="button" data-ref="index-create" class={ghostButton('sm')}>
          {INDEX_COPY.create}
        </button>
      </div>
      <ul
        data-ref="index-list"
        hidden
        class="grid gap-1 overflow-x-auto px-2 font-mono text-caption tnum text-muted"
      >
      </ul>
    </div>

    <fieldset class="grid gap-5">
      <legend class={`${legendText} mb-2.5`}>Carga de trabajo</legend>
      {
        numericFields.map((field) => (
          <div class="grid gap-2">
            <div class="flex items-center gap-1.5 px-2">
              <label for={`field-${field.name}`} class="text-body-sm font-medium text-secondary">
                {field.label}
              </label>
              <Fragment set:html={tip(field.term)} />
            </div>
            <input
              id={`field-${field.name}`}
              name={field.name}
              type="number"
              inputmode="numeric"
              value={field.value}
              min={field.limits.min}
              max={field.limits.max}
              step="1"
              aria-describedby={`hint-${field.name}`}
              class={numberField}
            />
            <span id={`hint-${field.name}`} class="px-2 text-xs text-muted">
              {field.hint}
            </span>
          </div>
        ))
      }
    </fieldset>

   </div>

    <ul
      data-ref="errors"
      hidden
      class="mt-10 grid gap-1 rounded-card bg-primary p-6 text-body-sm text-canvas"
    >
    </ul>

  </form>

  <div data-ref="step-analysis" hidden class="grid gap-10">
    <section class={panel} aria-labelledby="progress-heading">
      <div class="flex items-baseline justify-between gap-4">
        <h2 id="progress-heading" class={legendText}>Progreso de la ejecución</h2>
        <span data-ref="progress-label" class="font-mono text-body-sm tnum text-primary">0%</span>
      </div>

      <div
        data-ref="progress-track"
        role="progressbar"
        aria-labelledby="progress-heading"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
        class="mt-5 h-2 overflow-hidden rounded-pill bg-inset"
      >
        <div
          data-ref="progress-bar"
          style="width: 0%"
          class="h-full rounded-pill bg-primary transition-[width] duration-150 ease-out"
        >
        </div>
      </div>

      <p data-ref="status" role="status" aria-live="polite" class="mt-5 text-body-md text-secondary">
        En espera. Configura una ejecución e iníciala.
      </p>
    </section>

    <section class={panel} aria-labelledby="chart-heading">
      <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-4">
        <h2 id="chart-heading" class={`${legendText} flex items-center gap-2`}>
          <Fragment set:html={icon('chart-bar', 'size-4')} />
          <span data-ref="chart-heading-label">Latencia p95</span>
          <Fragment set:html={tip('p95')} />
        </h2>

        <div class="flex flex-wrap items-center gap-3">
          {/* Three views, never one plot with two axes: latency and throughput
              move in opposite directions as concurrency rises, so sharing a
              frame would invite exactly the comparison the numbers forbid. */}
          <div class={segmentTrack} role="tablist" aria-label="Vista del gráfico">
            <button
              type="button"
              data-ref="chart-tab"
              data-chart="p95"
              role="tab"
              aria-selected="true"
              class={segmentButton(true)}
            >
              {COPY.charts.p95}
            </button>
            <button
              type="button"
              data-ref="chart-tab"
              data-chart="samples"
              role="tab"
              aria-selected="false"
              class={segmentButton(false)}
            >
              {COPY.charts.samples}
            </button>
            <button
              type="button"
              data-ref="chart-tab"
              data-chart="throughput"
              role="tab"
              aria-selected="false"
              class={segmentButton(false)}
            >
              {COPY.charts.throughput}
            </button>
          </div>

          {/* Only the sample view needs one phase at a time; the other two show
              every phase at once. */}
          <label data-ref="phase-picker" hidden class="flex items-center gap-2">
            <span class="text-caption text-muted">{COPY.charts.phaseLabel}</span>
            <select
              data-ref="phase-select"
              class="rounded-input border border-hairline bg-canvas px-4 py-2 text-body-sm text-primary outline-none focus-visible:border-hairline-strong"
            >
            </select>
          </label>
        </div>
      </div>

      <div data-ref="chart" class="pt-6"></div>
    </section>

    <section class={panel} aria-labelledby="context-heading">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <h2 id="context-heading" class={`${legendText} flex items-center gap-2`}>
          <Fragment set:html={icon('circle-alert', 'size-4')} />
          Condiciones de la medición
        </h2>
        <button type="button" data-ref="context-refresh" class={ghostButton('sm')}>
          Volver a medir
        </button>
      </div>
      {/* A number without its conditions is an anecdote, not a measurement. */}
      <div data-ref="context" class="pt-6"></div>
    </section>

    <section class={`${panel} px-0`} aria-labelledby="results-heading">
      <h2 id="results-heading" class={`${legendText} flex items-center gap-2 px-10`}>
        <Fragment set:html={icon('table-2', 'size-4')} />
        Distribución de latencia
      </h2>
      <div data-ref="results" class="pt-4"></div>
    </section>
  </div>
</benchmark-console>

<script>
  import { renderContext } from '../../dataset/ui/render-context'
  import { initInfoTips } from '../../ui/info-tip'
  import './benchmark-console'

  // Fetched after paint, never during render: the probe pings both engines
  // seven times each, and blocking the page on that would trade a working
  // console for a spinner.
  const contextHost = document.querySelector('[data-ref="context"]')
  if (contextHost instanceof HTMLElement) {
    void renderContext(contextHost)
    document
      .querySelector('[data-ref="context-refresh"]')
      ?.addEventListener('click', () => void renderContext(contextHost))
  }

  // Delegated once for the whole document: the results table rebuilds its
  // headers on every event, so its tooltips are wired after this runs.
  initInfoTips()
</script>
